# --- required ---
MONGODB_URI= URI
MONGODB_DB=footy_quiz
BOT_TOKEN=123456:ABC-from-BotFather
ADMIN_IDS=123456789            # your Telegram user id (comma separate for more admins)
CRON_SECRET=pick-a-long-random-string

# --- channel posting ---
CHANNEL_ID=@yourchannel        # the bot must be an admin of the channel
MINI_APP_LINK=https://t.me/YourBot/play   # direct link: bot username / app short name
CHANNEL_HANDLE=@yourchannel    # printed on the winner card (optional)

# --- leaderboard day ---
APP_TZ=Africa/Lagos            # the 00:00-23:59 leaderboard day is measured in this timezone

# --- adsgram rewarded ads ---
VITE_ADSGRAM_BLOCK_ID=your-block-id-from-adsgram # e.g. int-9195

# --- local development only ---
# DEV_MODE=1                   # lets the browser act as a fake Telegram user (never set on Vercel)
